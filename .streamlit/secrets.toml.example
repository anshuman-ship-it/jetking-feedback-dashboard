# Copy this file to .streamlit/secrets.toml and fill in the values below.
#
# technical_url / employability_url / infrastructure_url: each sheet's
#   "Publish to web" CSV link (File -> Share -> Publish to web -> select the
#   "Form Responses 1" tab -> format: Comma-separated values (.csv) ->
#   Publish). See SETUP_GUIDE.md.
#
# Note: these URLs aren't secret in the traditional sense — once a sheet is
# published, anyone with the URL can view that data without logging in. The
# URL itself isn't guessable, but keep this file out of git anyway (it's
# already in .gitignore) since it's still the file that says which sheets
# are exposed this way.

[sheet_endpoints]
technical_url = "https://docs.google.com/spreadsheets/d/e/REPLACE_WITH_TECHNICAL_PUBLISH_ID/pub?output=csv"
employability_url = "https://docs.google.com/spreadsheets/d/e/REPLACE_WITH_EMPLOYABILITY_PUBLISH_ID/pub?output=csv"
infrastructure_url = "https://docs.google.com/spreadsheets/d/e/REPLACE_WITH_INFRASTRUCTURE_PUBLISH_ID/pub?output=csv"
