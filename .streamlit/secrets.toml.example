# Copy this file to .streamlit/secrets.toml and fill in the values below.
#
# technical_url / employability_url / infrastructure_url: each sheet's
#   "Publish to web" CSV link (File -> Share -> Publish to web -> select the
#   "Form Responses 1" tab -> format: Comma-separated values (.csv) ->
#   Publish). See SETUP_GUIDE.md.
#
# Note: these URLs aren't secret in the traditional sense — once a sheet is
# published, anyone with the URL can view that data without logging in. The
# URL itself isn't guessable, but keep this file out of git anyway (it's
# already in .gitignore) since it's still the file that says which sheets
# are exposed this way.

[sheet_endpoints]
technical_url = "https://docs.google.com/spreadsheets/d/e/REPLACE_WITH_TECHNICAL_PUBLISH_ID/pub?output=csv"
employability_url = "https://docs.google.com/spreadsheets/d/e/REPLACE_WITH_EMPLOYABILITY_PUBLISH_ID/pub?output=csv"
infrastructure_url = "https://docs.google.com/spreadsheets/d/e/REPLACE_WITH_INFRASTRUCTURE_PUBLISH_ID/pub?output=csv"

# ---------------------------------------------------------------------------
# Sign-in accounts (role-based access)
# ---------------------------------------------------------------------------
# Every person who should be able to open the app needs an entry here. There
# are two kinds of account:
#   - roles = ["admin"]                -> sees every centre, all three tabs
#   - roles = ["centre:<CentreName>"]  -> sees ONLY that centre's data; the
#                                          Centre filter is replaced with a
#                                          locked badge. <CentreName> must be
#                                          one of the keys in CENTRE_DISPLAY_NAMES
#                                          near the top of app.py (currently:
#                                          Dadar, Vashi, Laxminagar, Maninagar,
#                                          Bhawaniopore, Khar).
# An account with neither (or a typo'd centre name) is signed-in but sees a
# "no access role configured" message and nothing else — this is deliberate
# (fail closed), not a bug.
#
# cookie_key: a random secret used to sign the "stay logged in" cookie. Generate
# your own once with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# — don't reuse the example value below.
#
# Passwords must be bcrypt hashes, not plain text. To add a new account or
# change a password, generate the hash with:
#   python -c "import streamlit_authenticator as stauth; print(stauth.Hasher.hash('the-plaintext-password'))"
# and paste the resulting $2b$... string as that user's password value.

[credentials]
cookie_name = "jetking_feedback_auth"
cookie_key = "REPLACE_WITH_YOUR_OWN_RANDOM_STRING"
cookie_expiry_days = 30

[credentials.usernames."example.person@jetking.com"]
email = "example.person@jetking.com"
name = "Example Person"
password = "$2b$12$REPLACE_WITH_A_BCRYPT_HASH_FROM_THE_COMMAND_ABOVE"
roles = ["admin"]              # or roles = ["centre:Khar"], etc.
